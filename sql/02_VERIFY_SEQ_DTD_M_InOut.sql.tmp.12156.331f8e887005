-- =============================================================================
-- Script: Verify native Oracle sequences for M_InOut
-- Package: packages_CW
-- =============================================================================

-- Check all sequences created
SELECT sequence_name, last_number FROM user_sequences
WHERE sequence_name LIKE 'SEQ_DTD%'
ORDER BY sequence_name;

-- Check current max M_InOut_ID (should be < 1000000)
SELECT MAX(M_InOut_ID) AS max_inout_id FROM M_InOut;

-- Test each sequence (should return values starting from 1000000)
SELECT 'SEQ_DTD_M_InOut' as seq_name, SEQ_DTD_M_InOut.NEXTVAL FROM DUAL;
SELECT 'SEQ_DTD_M_InOut_SO' as seq_name, SEQ_DTD_M_InOut_SO.NEXTVAL FROM DUAL;
SELECT 'SEQ_DTD_M_InOut_PO' as seq_name, SEQ_DTD_M_InOut_PO.NEXTVAL FROM DUAL;
SELECT 'SEQ_DTD_M_InOut_MM' as seq_name, SEQ_DTD_M_InOut_MM.NEXTVAL FROM DUAL;
