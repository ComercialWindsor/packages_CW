									qtyAvai = Env.ZERO;								

								if(qtyAvai.subtract(oLine.getQtyOrdered()).compareTo(Env.ZERO) < 0)
									return "ERROR: Stock Insuficiente y NO Existen solicitudes abiertas. Linea OV:"+oLine.getLine() +". <LC: 616>";
							
								}
							}
						}
					}
				}
			}
		}
		
		return null;
	}	//	docValidate

	/**
	 *	User Login.
	 *	Called when preferences are set
