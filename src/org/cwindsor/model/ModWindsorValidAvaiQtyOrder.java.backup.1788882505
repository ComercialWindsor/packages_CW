												" AND mr.M_Warehouse_ID = "+order.getM_Warehouse_ID()+
												" AND rl.M_Product_ID = "+oLine.getM_Product_ID()+" AND qty > qtyUsed");
										//se revisa si existe solicitud de distribucion abierta
