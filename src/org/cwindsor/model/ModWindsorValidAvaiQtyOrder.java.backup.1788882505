												                  "            (1000110, 1000048, 1000568,1000582)) "+
												            " + (SELECT COALESCE (SUM (rl.qtyreserved), 0)     "+
												             "     FROM M_Requisitionline rl     "+
												              "         INNER JOIN M_Requisition r  "+
